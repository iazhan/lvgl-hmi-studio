<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.ChengePreviewView"
        Title="{res:Loc win.chenge.preview}"
        Width="1060"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*,Auto">
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.chenge.preview}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,380" Margin="12">
                <Border Grid.Column="0" Background="{StaticResource HmiBgPanelBrush}"
                        BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Panel>
                        <Image x:Name="ShotImage" Stretch="Uniform" Margin="8"/>
                        <TextBlock x:Name="ShotPlaceholder"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </Panel>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="10,0,0,0">
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock x:Name="SummaryText"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}"
                                   FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{res:Loc chenge.preview.clicks}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <TextBox x:Name="ClicksBox" FontSize="12"
                                 Watermark="{res:Loc chenge.preview.clicks.hint}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Text="{res:Loc chenge.preview.log}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" x:Name="LogBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="monospace"
                                 FontSize="11"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="12,0,12,12">
                <Button x:Name="BtnRerun" Content="{res:Loc chenge.preview.rerun}" Classes="accent"/>
                <Button x:Name="BtnOpenDir" Content="{res:Loc chenge.preview.open}"/>
                <Button x:Name="BtnClose" Content="{res:Loc chenge.preview.close}"/>
            </StackPanel>
        </Grid>
    </Border>
</cw:ChromeWindow>
