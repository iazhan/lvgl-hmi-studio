<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:editors="using:HmiEditor.App.Views.Editors"
             xmlns:views="using:HmiEditor.App.Views"
             xmlns:res="clr-namespace:HmiEditor.App.Resources"
             x:Class="HmiEditor.App.Views.PropertyPanelView">
    <UserControl.Styles>
        <!-- 属性分组卡片：亮一档背景 + 边框，与面板背景形成清晰层次 -->
        <Style Selector="Expander">
            <Setter Property="BorderBrush" Value="{StaticResource HmiInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource HmiTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="ExpandDirection" Value="Down"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Expander:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
        </Style>
        <!-- 整组只读时同步降低视觉权重，避免用户误以为仍可编辑。 -->
        <Style Selector="Expander:disabled">
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="BorderBrush" Value="{StaticResource HmiInputBorderBrush}"/>
        </Style>
        <!-- 键盘聚焦到分组时保持与鼠标悬停一致的视觉提示 -->
        <Style Selector="Expander:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
        </Style>
        <Style Selector="Expander ToggleButton:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource HmiBgElevatedBrush}"/>
        </Style>
        <!-- Expander 展开/折叠动画：内容区域高度平滑过渡 -->
        <Style Selector="Expander ContentPresenter">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Expander 头部悬停反馈（Expander 头部实为 ToggleButton） -->
        <Style Selector="Expander ToggleButton">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Expander ToggleButton:pointerover">
            <Setter Property="Background" Value="{StaticResource HmiBgElevatedBrush}"/>
        </Style>
        <!-- Expander 内文字样式：统一字号和颜色，确保对比度充足 -->
        <Style Selector="Expander TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource HmiTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 分组标题增加字重和最小高度，便于快速扫描与键盘操作 -->
        <Style Selector="Expander ToggleButton ContentPresenter TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <!-- 属性标签统一次级色，减少重复的局部 Foreground/VerticalAlignment 配置 -->
        <Style Selector="Expander Grid > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HmiTextSecondaryBrush}"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <!-- 分组内部网格统一行距，避免密集属性挤压和局部样式漂移 -->
        <Style Selector="Expander Grid">
            <Setter Property="RowSpacing" Value="4"/>
        </Style>
        <!-- 卡片内输入控件统一紧凑高度与圆角 -->
        <Style Selector="Expander TextBox, Expander fa|FANumberBox, Expander ComboBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 聚焦态：明确显示键盘焦点，提升 Tab 导航可发现性。
             与普通输入样式分离，避免后续控件模板变更时丢失焦点提示。 -->
        <!-- 所有属性编辑器共享同一焦点态，保证动态显示区域也有一致反馈。 -->
        <Style Selector="Expander TextBox:focus, Expander fa|FANumberBox:focus, Expander ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource HmiBgInputBrush}"/>
        </Style>
        <Style Selector="Expander TextBox:disabled, Expander fa|FANumberBox:disabled, Expander ComboBox:disabled">
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="IsDeferredScrollingEnabled" Value="True"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{StaticResource HmiBgPanelBrush}" Padding="8"
            BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1">
        <ScrollViewer>
            <StackPanel Spacing="6">
                <TextBlock Text="{res:Loc prop.title}" Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="18"
                           FontWeight="Bold" Margin="4,0,0,4"/>
                <TextBlock x:Name="InfoText" Text="{res:Loc prop.no.selection}"
                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"
                           Margin="4,0,0,8" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <!-- ═══ 屏幕页面属性（未选中控件时显示，参考 Figma/Sketch/XD 页面面板）═══ -->
                <Border x:Name="ScreenPropsPanel" Background="{StaticResource HmiBgPanelBrush}"
                        BorderBrush="{StaticResource HmiAccentBrush}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,4" IsVisible="False">
                    <StackPanel Spacing="6" Opacity="1">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                        </Transitions>
                    </StackPanel.Transitions>
                    <!-- 页面尺寸 -->
                    <Expander Header="{res:Loc prop.screen.page.size}" IsExpanded="True"
                              Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="70,*" Margin="0,4,0,0">
                            <TextBlock Text="{res:Loc prop.name}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="ScreenName" Grid.Row="0" Grid.Column="1"
                                     Text="" TextChanged="OnScreenPropertyChanged" Margin="0,2"/>
                            <TextBlock Text="{res:Loc project.settings.display.preset}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScreenPresetCombo" Grid.Row="1" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch" Margin="0,2"
                                      SelectionChanged="OnScreenPresetChanged"/>
                            <TextBlock Text="{res:Loc prop.width}" Grid.Row="2" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="ScreenWidth" Grid.Row="2" Grid.Column="1"
                                            Value="800" Minimum="1" Maximum="4096" SmallChange="1" LargeChange="50"
                                            SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            <TextBlock Text="{res:Loc prop.height}" Grid.Row="3" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="ScreenHeight" Grid.Row="3" Grid.Column="1"
                                            Value="480" Minimum="1" Maximum="4096" SmallChange="1" LargeChange="50"
                                            SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            <TextBlock Text="{res:Loc prop.screen.orientation}" Grid.Row="4" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScreenOrientationCombo" Grid.Row="4" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch" Margin="0,2"
                                      SelectionChanged="OnScreenOrientationChanged">
                                <ComboBoxItem Content="{res:Loc enum.orientation.landscape}" Tag="Landscape"/>
                                <ComboBoxItem Content="{res:Loc enum.orientation.portrait}" Tag="Portrait"/>
                            </ComboBox>
                        </Grid>
                    </Expander>

                    <!-- 背景样式 -->
                    <Expander Header="{res:Loc prop.screen.bg}" IsExpanded="True"
                              Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="60,*,24">
                                <TextBlock Text="{res:Loc prop.bg.color}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ScreenBgColor" Grid.Column="1"
                                         Text="" TextChanged="OnScreenPropertyChanged"
                                         PlaceholderText="{res:Loc prop.color.hint}" Margin="0,2"/>
                                <Border x:Name="SwatchScreenBg" Grid.Column="2"
                                        Width="22" Height="22" CornerRadius="4"
                                        Background="{StaticResource HmiAccentHoverBrush}"
                                        BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                        PointerPressed="OnColorSwatchClicked"
                                        Tag="ScreenBgColor" Cursor="Hand"/>
                            </Grid>
                            <!-- 背景图片 -->
                            <TextBlock Text="{res:Loc prop.screen.bg.image}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ComboBox x:Name="ScreenBgImageCombo"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnScreenBgImageChanged"/>
                                <Button x:Name="BtnChooseScreenBgImage"
                                        Content="{res:Loc prop.screen.bg.image.choose}"
                                        Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                        BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,3" FontSize="11"
                                        Click="OnChooseScreenBgImageClicked"/>
                                <Button x:Name="BtnClearScreenBgImage"
                                        Content="{res:Loc prop.screen.bg.image.clear}"
                                        Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                        BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,3" FontSize="11"
                                        Click="OnClearScreenBgImageClicked"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Text="{res:Loc prop.screen.bg.image.mode}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ScreenBgImageModeCombo" Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnScreenPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc prop.screen.bg.image.mode.tile}" Tag="Tile"/>
                                    <ComboBoxItem Content="{res:Loc prop.screen.bg.image.mode.stretch}" Tag="Stretch"/>
                                    <ComboBoxItem Content="{res:Loc prop.screen.bg.image.mode.center}" Tag="Center"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Text="{res:Loc prop.screen.bg.image.opacity}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ScreenBgImageOpacity" Grid.Column="1"
                                                Value="100" Minimum="0" Maximum="100" SmallChange="5"
                                                SpinButtonPlacementMode="Compact"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- 布局与响应式 -->
                    <Expander Header="{res:Loc prop.screen.layout}" IsExpanded="False"
                              Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="70,*">
                                <TextBlock Text="{res:Loc prop.screen.adaptive}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ScreenAdaptiveCombo" Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnScreenPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc enum.adaptive.none}" Tag="None"/>
                                    <ComboBoxItem Content="{res:Loc enum.adaptive.fit}" Tag="Fit"/>
                                    <ComboBoxItem Content="{res:Loc enum.adaptive.fill}" Tag="Fill"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="70,*">
                                <TextBlock Text="{res:Loc prop.screen.dpi}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ScreenDpi" Grid.Column="1"
                                                ToolTip.Tip="{res:Loc prop.screen.dpi.export.hint}"
                                                Value="1" Minimum="0.5" Maximum="3" SmallChange="0.1"
                                                SpinButtonPlacementMode="Compact"/>
                            </Grid>
                            <TextBlock Text="{res:Loc prop.screen.safe.area}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{res:Loc prop.screen.safe.left}" FontSize="10"
                                               Foreground="{StaticResource HmiTextHintBrush}"/>
                                    <fa:FANumberBox x:Name="SafeLeft" Minimum="0" Maximum="2000" SmallChange="1"
                                                    ToolTip.Tip="{res:Loc prop.screen.safearea.export.hint}"
                                                    SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Grid.Column="1">
                                    <TextBlock Text="{res:Loc prop.screen.safe.top}" FontSize="10"
                                               Foreground="{StaticResource HmiTextHintBrush}"/>
                                    <fa:FANumberBox x:Name="SafeTop" Minimum="0" Maximum="2000" SmallChange="1"
                                                    ToolTip.Tip="{res:Loc prop.screen.safearea.export.hint}"
                                                    SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Grid.Column="2">
                                    <TextBlock Text="{res:Loc prop.screen.safe.right}" FontSize="10"
                                               Foreground="{StaticResource HmiTextHintBrush}"/>
                                    <fa:FANumberBox x:Name="SafeRight" Minimum="0" Maximum="2000" SmallChange="1"
                                                    ToolTip.Tip="{res:Loc prop.screen.safearea.export.hint}"
                                                    SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Grid.Column="3">
                                    <TextBlock Text="{res:Loc prop.screen.safe.bottom}" FontSize="10"
                                               Foreground="{StaticResource HmiTextHintBrush}"/>
                                    <fa:FANumberBox x:Name="SafeBottom" Minimum="0" Maximum="2000" SmallChange="1"
                                                    ToolTip.Tip="{res:Loc prop.screen.safearea.export.hint}"
                                                    SpinButtonPlacementMode="Compact"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- 交互行为 -->
                    <Expander Header="{res:Loc prop.screen.interaction}" IsExpanded="False"
                              Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <CheckBox x:Name="ScreenIsBoot" Content="{res:Loc prop.screen.boot}"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                      IsCheckedChanged="OnScreenPropertyChanged" Margin="0,4,0,0"/>
                            <!-- 公共页面：多用户共享查看 + 实时同步 + 权限控制 -->
                            <CheckBox x:Name="ScreenIsPublic" Content="{res:Loc prop.screen.public}"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                      IsCheckedChanged="OnScreenPropertyChanged" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="70,*">
                                <TextBlock Text="{res:Loc prop.screen.public.access}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="ScreenPublicAccessCombo" Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                          HorizontalAlignment="Stretch" IsEnabled="False"
                                          SelectionChanged="OnScreenPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc enum.public.access.public}" Tag="Public"/>
                                    <ComboBoxItem Content="{res:Loc enum.public.access.viewers}" Tag="Viewers"/>
                                    <ComboBoxItem Content="{res:Loc enum.public.access.admin}" Tag="AdminOnly"/>
                                </ComboBox>
                            </Grid>
                            <!-- 引用图层：公共页面作为本屏幕的背景图层（公共页面自身不能引用图层） -->
                            <StackPanel x:Name="ScreenLayerRefsSection" Margin="0,6,0,0" Spacing="4">
                                <TextBlock Text="{res:Loc prop.screen.layer.refs}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                           TextWrapping="Wrap"/>
                                <WrapPanel x:Name="ScreenLayerRefsPanel" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </Border>

                <!-- ═══ 几何与层级：位置、尺寸和静态可见性 ═══ -->
                <Expander x:Name="GeometryExpander" Header="{res:Loc prop.pos.size}" IsExpanded="True"
                          Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="70,*" Margin="0,4,0,0">
                        <TextBlock Text="{res:Loc prop.x}" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <fa:FANumberBox x:Name="PropX" Grid.Row="0" Grid.Column="1"
                                      Value="0" Minimum="0" SmallChange="1" LargeChange="10"
                                      SpinButtonPlacementMode="Compact"
                                      Margin="0,2"/>
                        <TextBlock Text="{res:Loc prop.y}" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <fa:FANumberBox x:Name="PropY" Grid.Row="1" Grid.Column="1"
                                      Value="0" Minimum="0" SmallChange="1" LargeChange="10"
                                      SpinButtonPlacementMode="Compact"
                                      Margin="0,2"/>
                        <TextBlock Text="{res:Loc prop.width}" Grid.Row="2" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <fa:FANumberBox x:Name="PropWidth" Grid.Row="2" Grid.Column="1"
                                      Value="100" Minimum="10" SmallChange="1" LargeChange="10"
                                      SpinButtonPlacementMode="Compact"
                                      Margin="0,2"/>
                        <TextBlock Text="{res:Loc prop.height}" Grid.Row="3" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <fa:FANumberBox x:Name="PropHeight" Grid.Row="3" Grid.Column="1"
                                      Value="40" Minimum="10" SmallChange="1" LargeChange="10"
                                      SpinButtonPlacementMode="Compact"
                                      Margin="0,2"/>
                        <Grid x:Name="RowVisible" Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="70,*">
                            <TextBlock x:Name="LblVisible" Text="{res:Loc prop.visible}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="PropVisible" Grid.Column="1"
                                      Content="{res:Loc prop.visible.hint}"
                                      IsChecked="True" IsCheckedChanged="OnPropertyChanged"/>
                        </Grid>
                        <TextBlock x:Name="LblRotation" Text="{res:Loc prop.param.rotation}" Grid.Row="5" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <fa:FANumberBox x:Name="RotationBox" Minimum="0" Maximum="360"
                                            SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                            <Button x:Name="BtnResetRotation" Grid.Column="1"
                                    Content="{res:Loc prop.param.rotation.reset}"
                                    Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiLinkBrush}"
                                    BorderThickness="0" Padding="8,2" FontSize="11" Margin="0,2" IsVisible="False"
                                    Click="OnResetRotationClicked"/>
                        </Grid>
                        <TextBlock x:Name="LblRotationDir" Text="{res:Loc prop.param.rotation.dir}" Grid.Row="6" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="RotationDirCombo" Grid.Row="6" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13" SelectedIndex="0"
                                  IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.param.rotation.cw}" Tag="CW"/>
                            <ComboBoxItem Content="{res:Loc prop.param.rotation.ccw}" Tag="CCW"/>
                        </ComboBox>
                        <TextBlock x:Name="LblMirrorH" Text="{res:Loc prop.param.mirror.h}" Grid.Row="7" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="MirrorHCheck" Grid.Row="7" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblMirrorV" Text="{res:Loc prop.param.mirror.v}" Grid.Row="8" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="MirrorVCheck" Grid.Row="8" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock Text="{res:Loc prop.enabled}" Grid.Row="9" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="PropEnabled" Grid.Row="9" Grid.Column="1"
                                  Content="{res:Loc prop.enabled.hint}"
                                  IsChecked="True" IsCheckedChanged="OnPropertyChanged"/>
                    </Grid>
                </Expander>

                <Expander x:Name="ContentAppearanceSection" Header="{res:Loc prop.section.content.text}" IsExpanded="True"
                          Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4">
                    <StackPanel Margin="0,4,0,0" Spacing="6">
                        <!-- 内容字段 -->
                        <StackPanel x:Name="BasicContentPanel" Spacing="6">
                        <Grid ColumnDefinitions="62,*">
                            <TextBlock Text="{res:Loc prop.name}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PropName" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"/>
                        </Grid>
                        <Grid x:Name="RowText" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblPropText" Text="{res:Loc prop.text}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <!-- 开关的框里那段文字会导出成 text_on（画在控件框右边），
                                 用「内容」这个标签等于让人猜它是干嘛的 -->
                            <TextBlock x:Name="LblPropTextOn" Text="{res:Loc prop.text.on}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"
                                       IsVisible="False"/>
                            <TextBox x:Name="PropText" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"/>
                        </Grid>
                        <!-- 开关的关闭态文字（导出成 text_off，打开态用上面那格） -->
                        <Grid x:Name="RowSwitchTextOff" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblSwitchTextOff" Text="{res:Loc prop.text.off}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SwitchTextOffBox" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"/>
                        </Grid>
                        </StackPanel>
                        <!-- 外观属性 -->
                        <StackPanel x:Name="AppearanceExpander" Spacing="6" VerticalAlignment="Top">
                            <TextBlock Text="{res:Loc prop.appearance}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>

                        <!-- 背景色（含色板） -->
                        <Grid x:Name="RowBgColor" ColumnDefinitions="62,*,28">
                            <TextBlock x:Name="LblBgColor" Text="{res:Loc prop.bg.color}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PropBgColor" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                            <Border x:Name="SwatchBgColor" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiAccentHoverBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="PropBgColor" Cursor="Hand"/>
                        </Grid>
                        <!-- 不透明度 -->
                        <Grid x:Name="RowOpacity" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblOpacity" Text="{res:Loc prop.opacity}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="OpacityBox" Grid.Column="1"
                                            Value="100" Minimum="0" Maximum="100"
                                            SmallChange="5" LargeChange="10"
                                            SpinButtonPlacementMode="Compact"/>
                        </Grid>
                        <!-- 圆角 -->
                        <Grid x:Name="RowRadius" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblRadius" Text="{res:Loc prop.radius}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="PropRadius" Grid.Column="1"
                                            Value="0" Minimum="0" SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Compact"/>
                        </Grid>
                        <!-- 边框宽度 -->
                        <Grid x:Name="RowBorderWidth" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblBorderWidth" Text="{res:Loc prop.border.width}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="PropBorderWidth" Grid.Column="1"
                                            Value="0" Minimum="0" SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Compact"/>
                        </Grid>
                        <!-- 边框颜色 -->
                        <Grid x:Name="RowBorderColor" ColumnDefinitions="62,*,28">
                            <TextBlock x:Name="LblBorderColor" Text="{res:Loc prop.border.color}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PropBorderColor" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                            <Border x:Name="SwatchBorderColor" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiInputBorderBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="PropBorderColor" Cursor="Hand"/>
                        </Grid>
                        <!-- 文本色 -->
                        <Grid x:Name="RowTextColor" ColumnDefinitions="62,*,28">
                            <TextBlock x:Name="LblTextColor" Text="{res:Loc prop.text.color}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PropTextColor" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                            <Border x:Name="SwatchTextColor" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiTextPrimaryBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="PropTextColor" Cursor="Hand"/>
                        </Grid>
                        <!-- 字体（下拉选已有字体资源） -->
                        <Grid x:Name="RowFontFamily" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblFontFamily" Text="{res:Loc prop.font.family}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PropFontFamily" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnPropertyChanged"/>
                        </Grid>
                        <!-- 字号 -->
                        <Grid x:Name="RowFontSize" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblFontSize" Text="{res:Loc prop.font.size}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="PropFontSize" Grid.Column="1"
                                            Value="14" Minimum="6" Maximum="72"
                                            ToolTip.Tip="{res:Loc prop.font.size.export.hint}"
                                            SmallChange="1" LargeChange="4"
                                            SpinButtonPlacementMode="Compact"/>
                        </Grid>
                        <!-- 水平对齐 -->
                        <Grid x:Name="RowTextAlign" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblTextAlign" Text="{res:Loc prop.text.align}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PropTextAlign" Grid.Column="1"
                                      ToolTip.Tip="{res:Loc prop.text.align.export.hint}"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnPropertyChanged">
                                <ComboBoxItem Content="{res:Loc prop.visual.state.align.left}" Tag="Left"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.align.center}" Tag="Center"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.align.right}" Tag="Right"/>
                            </ComboBox>
                        </Grid>
                        <!-- 垂直对齐 -->
                        <Grid x:Name="RowTextVAlign" ColumnDefinitions="62,*">
                            <TextBlock x:Name="LblTextVAlign" Text="{res:Loc prop.text.valign}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PropTextVAlign" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnPropertyChanged">
                                <ComboBoxItem Content="{res:Loc prop.visual.state.valign.top}" Tag="Top"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.valign.middle}" Tag="Middle"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.valign.bottom}" Tag="Bottom"/>
                            </ComboBox>
                        </Grid>
                        <!-- 文字排版（仅 Label）：字形 / 字距 / 行距 / 超长处理。
                             与字号、对齐是同一件事，必须同处一组 —— 分开摆的话配一段文字
                             要开两个折叠面板。 -->
                        <Grid x:Name="RowLabelFontStyle" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblLabelFontStyle" Text="{res:Loc prop.detail.label.font}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LabelFontStyleCombo" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnPropertyChanged">
                                <ComboBoxItem Content="{res:Loc prop.detail.label.font.normal}" Tag="normal"/>
                                <ComboBoxItem Content="{res:Loc prop.detail.label.font.bold}" Tag="bold"/>
                                <ComboBoxItem Content="{res:Loc prop.detail.label.font.italic}" Tag="italic"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="RowLetterSpacing" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblLetterSpacing" Text="{res:Loc prop.detail.label.letter}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="LetterSpacingBox" Grid.Column="1"
                                            Value="0" Minimum="0" Maximum="32"
                                            SpinButtonPlacementMode="Compact" Margin="0,2"/>
                        </Grid>
                        <Grid x:Name="RowLineSpacing" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblLineSpacing" Text="{res:Loc prop.detail.label.line}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="LineSpacingBox" Grid.Column="1"
                                            Value="0" Minimum="0" Maximum="64"
                                            SpinButtonPlacementMode="Compact" Margin="0,2"/>
                        </Grid>
                        <Grid x:Name="RowLongMode" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblLongMode" Text="{res:Loc prop.param.longmode}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LongModeCombo" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnPropertyChanged">
                                <ComboBoxItem Content="{res:Loc prop.param.longmode.wrap}" Tag="Wrap"/>
                                <ComboBoxItem Content="{res:Loc prop.param.longmode.dots}" Tag="Dots"/>
                                <ComboBoxItem Content="{res:Loc prop.param.longmode.scroll}" Tag="Scroll"/>
                                <ComboBoxItem Content="{res:Loc prop.param.longmode.scrollcirc}" Tag="ScrollCircular"/>
                                <ComboBoxItem Content="{res:Loc prop.param.longmode.clip}" Tag="Clip"/>
                            </ComboBox>
                        </Grid>
                        <!-- 指示器颜色（仅 Slider/Bar/Switch/Gauge/Knob） -->
                        <Grid x:Name="RowIndicatorColor" ColumnDefinitions="62,*,28" IsVisible="False">
                            <TextBlock x:Name="LblIndicatorColor" Text="{res:Loc prop.indicator.color}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="IndicatorColorBox" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                            <Border x:Name="SwatchIndicatorColor" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiLinkBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="IndicatorColor" Cursor="Hand"/>
                        </Grid>
                        <!-- 开关的三段颜色（仅 Switch）：打开轨道 / 关闭轨道 / 滑块 -->
                        <Grid x:Name="RowSwitchColorOn" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblSwitchOn" Text="{res:Loc prop.detail.switch.on}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SwitchColorOnBox" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                        </Grid>
                        <Grid x:Name="RowSwitchColorOff" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblSwitchOff" Text="{res:Loc prop.detail.switch.off}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SwitchColorOffBox" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                        </Grid>
                        <Grid x:Name="RowSwitchKnob" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblSwitchKnob" Text="{res:Loc prop.detail.switch.knob}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SwitchKnobColorBox" Grid.Column="1"
                                     Text="" TextChanged="OnPropertyChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- ═══ 绑定与状态 ═══ -->
                <Expander x:Name="BindingStateSection" Header="{res:Loc prop.section.binding.state}" IsExpanded="False"
                          Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4"
                          IsVisible="False">
                    <StackPanel Margin="0,4,0,0" Spacing="6">
                        <StackPanel x:Name="VisualStateExpander" Spacing="6" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.visual.states}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <!-- 状态选择 + 继承提示 -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="{res:Loc prop.visual.state.select}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                            <ComboBox x:Name="CboVisualState"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                      SelectedIndex="0"
                                      SelectionChanged="OnVisualStateChanged">
                                <ComboBoxItem Content="{res:Loc prop.visual.state.normal}" Tag="Normal"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.pressed}" Tag="Pressed"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.checked}" Tag="Checked"/>
                                <ComboBoxItem Content="{res:Loc prop.visual.state.disabled}" Tag="Disabled"/>
                            </ComboBox>
                            <TextBlock Text="{res:Loc prop.visual.state.inherit.hint}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 子标题：颜色属性 -->
                        <TextBlock Text="{res:Loc prop.section.color}"
                                   Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="62,*,28" RowSpacing="6">
                            <TextBlock Text="{res:Loc prop.visual.state.bg.color}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="VsBgColor" Grid.Row="0" Grid.Column="1"
                                     Text="" TextChanged="OnVisualStateChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}" FontSize="12"/>
                            <Border x:Name="SwatchVsBgColor" Grid.Row="0" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiAccentHoverBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="VsBgColor" Cursor="Hand"/>
                            <TextBlock Text="{res:Loc prop.visual.state.text.color}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="VsTextColor" Grid.Row="1" Grid.Column="1"
                                     Text="" TextChanged="OnVisualStateChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}" FontSize="12"/>
                            <Border x:Name="SwatchVsTextColor" Grid.Row="1" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiTextPrimaryBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="VsTextColor" Cursor="Hand"/>
                            <TextBlock Text="{res:Loc prop.visual.state.border.color}" Grid.Row="2" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="VsBorderColor" Grid.Row="2" Grid.Column="1"
                                     Text="" TextChanged="OnVisualStateChanged"
                                     PlaceholderText="{res:Loc prop.color.hint}" FontSize="12"/>
                            <Border x:Name="SwatchVsBorderColor" Grid.Row="2" Grid.Column="2"
                                    Width="22" Height="22" CornerRadius="4"
                                    Background="{StaticResource HmiInputBorderBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    PointerPressed="OnColorSwatchClicked"
                                    Tag="VsBorderColor" Cursor="Hand"/>
                        </Grid>

                        <!-- 子标题：状态覆盖内容；默认态文本统一在“内容与文字”中编辑 -->
                        <TextBlock Text="{res:Loc prop.section.content}"
                                   Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="VsTextDefaultHint"
                                   Text="{res:Loc prop.visual.state.normal.text.hint}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" IsVisible="False"/>
                        <TextBox x:Name="VsText"
                                 Text="" TextChanged="OnVisualStateChanged"
                                 ToolTip.Tip="{res:Loc prop.visual.state.export.hint.text}"
                                 PlaceholderText="{res:Loc prop.visual.state.inherit.hint}"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12" Padding="8,4"/>
                        <Grid x:Name="RowVsTextAlignment" RowDefinitions="Auto,Auto" ColumnDefinitions="62,*" RowSpacing="6" Margin="0,2">
                            <TextBlock Text="{res:Loc prop.visual.state.text.align}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox x:Name="VsTextAlign" Grid.Row="0" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnVisualStateChanged"/>
                            <TextBlock Text="{res:Loc prop.visual.state.text.valign}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox x:Name="VsTextVAlign" Grid.Row="1" Grid.Column="1"
                                      ToolTip.Tip="{res:Loc prop.visual.state.export.hint.valign}"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnVisualStateChanged"/>
                        </Grid>

                        <!-- 子标题：图片属性 -->
                        <TextBlock Text="{res:Loc prop.section.image}"
                                   Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox x:Name="CboVsImage"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnVisualStateChanged"/>
                            <Button x:Name="BtnVsImageClear"
                                    Content="{res:Loc prop.visual.state.image.clear}"
                                    Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                    BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" FontSize="11"
                                    Click="OnVsImageClearClicked"/>
                        </StackPanel>
                    </StackPanel>
                        <StackPanel x:Name="VariableBindingExpander" Spacing="4">

                        <!-- 目标属性：值属性（Text/Value）走值通路，视觉属性（颜色/可见性）走视觉通路。
                             P1-1：表达式可驱动颜色/可见性，生成代码里由同一套刷新器按属性名派发。 -->
                        <TextBlock Text="{res:Loc prop.bind.target}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <ComboBox x:Name="TargetPropertyCombo"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0"
                                  SelectionChanged="OnTargetPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.bind.target.value}" Tag="Text"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.target.numValue}" Tag="Value"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.target.checked}" Tag="IsChecked"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.target.textColor}" Tag="TextColor"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.target.bgColor}" Tag="BgColor"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.target.visible}" Tag="IsVisible"/>
                        </ComboBox>
                        <TextBlock Text="{res:Loc prop.bind.source}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <ComboBox x:Name="BindingKindCombo"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="{res:Loc var.tab.variable}" Tag="Variable"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.source.expression}" Tag="Expression"/>
                        </ComboBox>
                        <TextBlock x:Name="BindVariableLabel" Text="{res:Loc prop.bind.var}" Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"/>
                        <editors:VariablePicker x:Name="VariablePicker"/>
                        <TextBlock x:Name="ExpressionLabel" Text="{res:Loc prop.expression}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13" IsVisible="False"/>
                        <TextBox x:Name="ExpressionInput"
                                 PlaceholderText="{res:Loc prop.expr.hint}"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 IsVisible="False" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExpressionErrorText" Text=""
                                   Foreground="{StaticResource HmiDangerBrush}" FontSize="11"
                                   TextWrapping="Wrap" IsVisible="False"/>
                        <TextBlock Text="{res:Loc prop.bind.mode}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <ComboBox x:Name="BindingModeCombo"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="{res:Loc prop.bind.readwrite}" Tag="ReadWrite"/>
                            <ComboBoxItem Content="{res:Loc prop.bind.readonly}" Tag="ReadOnly"/>
                        </ComboBox>
                        <TextBlock x:Name="BindingHint" Text=""
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 初始选中（仅 CheckBox/Switch）：导出成 checked，是「目标属性=IsChecked」
                             那条绑定的初值，不是外观样式。 -->
                        <Grid x:Name="RowIsChecked" ColumnDefinitions="62,*" IsVisible="False">
                            <TextBlock x:Name="LblIsChecked" Text="{res:Loc prop.selected}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="PropIsChecked" Grid.Column="1"
                                      IsCheckedChanged="OnPropertyChanged"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ═══ 数据与显示 ═══ -->
                <Expander x:Name="DataDisplaySection" Header="{res:Loc prop.param.title}" IsExpanded="False"
                          Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4"
                          IsVisible="False">
                    <StackPanel Margin="0,4,0,0" Spacing="6">
                        <StackPanel x:Name="ValueDisplayExpander" Spacing="4" IsVisible="False">

                        <TextBlock Text="{res:Loc prop.value.display.type}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <ComboBox x:Name="ValueDisplayTypeCombo"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0"
                                  SelectionChanged="OnValueDisplayTypeChanged">
                            <ComboBoxItem Content="{res:Loc prop.value.display.auto}" Tag="Auto"/>
                            <ComboBoxItem Content="{res:Loc prop.value.display.bool}" Tag="Bool"/>
                            <ComboBoxItem Content="{res:Loc prop.value.display.int}" Tag="Int"/>
                            <ComboBoxItem Content="{res:Loc prop.value.display.float}" Tag="Float"/>
                            <ComboBoxItem Content="{res:Loc prop.value.display.string}" Tag="String"/>
                        </ComboBox>
                        <TextBlock x:Name="LblValueDecimals" Text="{res:Loc prop.value.display.decimals}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11" IsVisible="False"/>
                        <ComboBox x:Name="ValueDecimalsCombo"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="1" IsVisible="False"
                                  SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="0" Tag="0"/>
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="3" Tag="3"/>
                            <ComboBoxItem Content="4" Tag="4"/>
                        </ComboBox>
                        <!-- 排布顺序与最终显示一致：倍率 → 前缀 → 单位 → 后缀。
                             「单位」跟前后缀是同一件事（都拼在数值两侧），必须放同一组，
                             否则面板上要开两个折叠面板才能配完一个读数。 -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="70,*" RowSpacing="4">
                            <TextBlock Text="{res:Loc prop.value.display.scale}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <fa:FANumberBox x:Name="ValueScaleBox" Grid.Row="0" Grid.Column="1"
                                            Value="1" Minimum="0.0001" Maximum="1000000"
                                            SmallChange="0.1" SpinButtonPlacementMode="Compact"
                                            Margin="0,2"/>
                            <TextBlock Text="{res:Loc prop.value.display.prefix}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="ValuePrefixBox" Grid.Row="1" Grid.Column="1"
                                     Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                     BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                     TextChanged="OnPropertyChanged" Margin="0,2"/>
                            <TextBlock x:Name="LblUnit" Text="{res:Loc prop.param.unit}" Grid.Row="2" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UnitBox" Grid.Row="2" Grid.Column="1" FontSize="13" Margin="0,2"
                                     Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                     BorderBrush="{StaticResource HmiInputBorderBrush}"
                                     TextChanged="OnPropertyChanged"/>
                        </Grid>
                        <TextBlock Text="{res:Loc prop.value.display.suffix}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"/>
                        <TextBox x:Name="ValueSuffixBox"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 TextChanged="OnPropertyChanged"/>
                    </StackPanel>
                        <!-- 控件专属数据参数 -->
                        <StackPanel x:Name="ControlParamExpander" Spacing="4" IsVisible="False">
                    <!-- 行数要 ≥ 下面最大的 Grid.Row+1（当前 0..59）。
                         少一行不会报错，但多出来的控件会**全部叠在最后一行**上，肉眼像"属性丢了"。 -->
                    <Grid x:Name="ControlParamGrid"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="70,*" RowSpacing="0" Margin="0,4,0,0">
                        <!-- 必须显式 RowSpacing="0"：本表大部分行对某个控件类型是隐藏的，而
                             RowSpacing 对 0 高度的隐藏行照样生效（88 行 × 4px ≈ 350px 空白）。
                             `Expander Grid` 那条全局样式默认给 4，局部写 0 才能压住它。
                             行间距由每个输入控件自带的 Margin="0,2" 提供。 -->
                        <TextBlock x:Name="LblMinValue" Text="{res:Loc prop.param.min}" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="MinValueBox" Grid.Row="0" Grid.Column="1"
                                        Value="0" Minimum="-1000000" Maximum="1000000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblMaxValue" Text="{res:Loc prop.param.max}" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="MaxValueBox" Grid.Row="1" Grid.Column="1"
                                        Value="100" Minimum="-1000000" Maximum="1000000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblStepValue" Text="{res:Loc prop.param.step}" Grid.Row="2" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="StepValueBox" Grid.Row="2" Grid.Column="1"
                                        Value="1" Minimum="0.0001" Maximum="1000000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblOptions" Text="{res:Loc prop.param.options}" Grid.Row="3" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="OptionsBox" Grid.Row="3" Grid.Column="1"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                                 TextChanged="OnPropertyChanged" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblSelectedIndex" Text="{res:Loc prop.param.selected}" Grid.Row="4" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="SelectedIndexBox" Grid.Row="4" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="10000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblPlaceholder" Text="{res:Loc prop.param.placeholder}" Grid.Row="5" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="PlaceholderBox" Grid.Row="5" Grid.Column="1"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 TextChanged="OnPropertyChanged" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblMaxLength" Text="{res:Loc prop.param.maxlen}" Grid.Row="6" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="MaxLengthBox" Grid.Row="6" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="10000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblPassword" Text="{res:Loc prop.param.password}" Grid.Row="7" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="PasswordCheck" Grid.Row="7" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblTickCount" Text="{res:Loc prop.param.ticks}" Grid.Row="8" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="TickCountBox" Grid.Row="8" Grid.Column="1"
                                        Value="6" Minimum="2" Maximum="50"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblRowCount" Text="{res:Loc prop.param.rows}" Grid.Row="9" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="RowCountBox" Grid.Row="9" Grid.Column="1"
                                        Value="3" Minimum="1" Maximum="100"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblColCount" Text="{res:Loc prop.param.cols}" Grid.Row="10" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="ColCountBox" Grid.Row="10" Grid.Column="1"
                                        Value="3" Minimum="1" Maximum="100"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblHeader" Text="{res:Loc prop.param.header}" Grid.Row="11" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="HeaderBox" Grid.Row="11" Grid.Column="1"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 PlaceholderText="{res:Loc prop.param.header.hint}"
                                 TextChanged="OnPropertyChanged" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblTabTitles" Text="{res:Loc prop.param.tabs}" Grid.Row="12" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="TabTitlesBox" Grid.Row="12" Grid.Column="1"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 PlaceholderText="{res:Loc prop.param.tabs.hint}"
                                 TextChanged="OnPropertyChanged" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblStretch" Text="{res:Loc prop.param.stretch}" Grid.Row="13" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="StretchCombo" Grid.Row="13" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="1" IsVisible="False"
                                  SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="None" Tag="None"/>
                            <ComboBoxItem Content="Fill" Tag="Fill"/>
                            <ComboBoxItem Content="Contain" Tag="Contain"/>
                        </ComboBox>
                        <TextBlock x:Name="LblBrightness" Text="{res:Loc prop.param.brightness}" Grid.Row="14" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="BrightnessBox" Grid.Row="14" Grid.Column="1"
                                        Value="255" Minimum="0" Maximum="255"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblSpinSpeed" Text="{res:Loc prop.param.speed}" Grid.Row="15" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="SpinSpeedBox" Grid.Row="15" Grid.Column="1"
                                        Value="1000" Minimum="100" Maximum="10000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblPipeDirection" Text="{res:Loc prop.param.pipe.direction}" Grid.Row="22" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="PipeDirectionCombo" Grid.Row="22" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False"
                                  SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.param.pipe.direction.horizontal}" Tag="Horizontal"/>
                            <ComboBoxItem Content="{res:Loc prop.param.pipe.direction.vertical}" Tag="Vertical"/>
                        </ComboBox>
                        <TextBlock x:Name="LblPipeFlowDirection" Text="{res:Loc prop.param.pipe.flowdirection}" Grid.Row="23" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="PipeFlowDirectionCombo" Grid.Row="23" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False"
                                  SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.param.pipe.flowdirection.forward}" Tag="Forward"/>
                            <ComboBoxItem Content="{res:Loc prop.param.pipe.flowdirection.reverse}" Tag="Reverse"/>
                        </ComboBox>
                        <TextBlock x:Name="LblPipeFlowSpeed" Text="{res:Loc prop.param.pipe.flowspeed}" Grid.Row="24" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="PipeFlowSpeedBox" Grid.Row="24" Grid.Column="1"
                                        Value="2000" Minimum="0" Maximum="10000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblValveType" Text="{res:Loc prop.param.valve.type}" Grid.Row="25" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="ValveTypeCombo" Grid.Row="25" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False"
                                  SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.param.valve.type.ball}" Tag="Ball"/>
                            <ComboBoxItem Content="{res:Loc prop.param.valve.type.gate}" Tag="Gate"/>
                            <ComboBoxItem Content="{res:Loc prop.param.valve.type.butterfly}" Tag="Butterfly"/>
                            <ComboBoxItem Content="{res:Loc prop.param.valve.type.globe}" Tag="Globe"/>
                        </ComboBox>
                        <Button x:Name="EditCellsBtn" Grid.Row="26" Grid.Column="0" Grid.ColumnSpan="2"
                                Content="{res:Loc prop.table.cells.edit}"
                                Background="{StaticResource HmiNeutralDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="12,6" FontSize="12" HorizontalAlignment="Left"
                                Click="OnEditCellsClicked" IsVisible="False"/>
                        <TextBlock x:Name="LblImageAsset" Text="{res:Loc prop.param.image}" Grid.Row="27" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="ImageAssetCombo" Grid.Row="27" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False"
                                  SelectionChanged="OnImageAssetChanged"/>
                        <TextBlock x:Name="LblSvgAsset" Text="{res:Loc prop.param.svg}" Grid.Row="28" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="SvgAssetCombo" Grid.Row="28" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False"
                                  SelectionChanged="OnSvgAssetChanged"/>
                        <TextBlock x:Name="LblRowHeight" Text="{res:Loc prop.param.rowheight}" Grid.Row="29" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="RowHeightBox" Grid.Row="29" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="10000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblColWidths" Text="{res:Loc prop.param.colwidths}" Grid.Row="30" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="ColWidthsBox" Grid.Row="30" Grid.Column="1"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                 PlaceholderText="{res:Loc prop.param.colwidths.hint}"
                                 TextChanged="OnPropertyChanged" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblShowTicks" Text="{res:Loc prop.param.showticks}" Grid.Row="31" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="ShowTicksCheck" Grid.Row="31" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblShowPointer" Text="{res:Loc prop.param.showpointer}" Grid.Row="32" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="ShowPointerCheck" Grid.Row="32" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <!-- chenge-runtime 数据控件参数（value / alarm_list / history_curve） -->
                        <TextBlock x:Name="LblCgAlarmGroup" Text="{res:Loc prop.param.alarm.group}" Grid.Row="38" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CgAlarmGroupBox" Grid.Row="38" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCgAlarmMode" Text="{res:Loc prop.param.alarm.mode}" Grid.Row="39" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="CgAlarmModeCombo" Grid.Row="39" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.param.alarm.mode.active}" Tag="active"/>
                            <ComboBoxItem Content="{res:Loc prop.param.alarm.mode.history}" Tag="history"/>
                        </ComboBox>
                        <TextBlock x:Name="LblCgAlarmRows" Text="{res:Loc prop.param.alarm.rows}" Grid.Row="40" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CgAlarmRowsBox" Grid.Row="40" Grid.Column="1"
                                        Value="10" Minimum="1" Maximum="500"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCgTrendGroup" Text="{res:Loc prop.param.trend.group}" Grid.Row="41" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CgTrendGroupBox" Grid.Row="41" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCgSpanMin" Text="{res:Loc prop.param.trend.span}" Grid.Row="42" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CgSpanMinBox" Grid.Row="42" Grid.Column="1"
                                        Value="30" Minimum="1" Maximum="1440"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCgCurveVars" Text="{res:Loc prop.param.trend.channels}" Grid.Row="43" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CgCurveVarsBox" Grid.Row="43" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <!-- 图片族（值换图/帧动画/二维码）与内容型（消息条/枚举文本/滚轮）的专属行。
                             这几类此前面板上一行都没有，等于不可配；值换图与帧动画还会因为缺必填项
                             直接导出失败。 -->
                        <TextBlock x:Name="LblStateImages" Text="{res:Loc prop.detail.stateimage.images}" Grid.Row="44" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="StateImagesBox" Grid.Row="44" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.stateimage.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblFrameImages" Text="{res:Loc prop.detail.frameanim.frames}" Grid.Row="45" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="FrameImagesBox" Grid.Row="45" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.frameanim.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblFrameInterval" Text="{res:Loc prop.detail.frameanim.interval}" Grid.Row="46" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="FrameIntervalBox" Grid.Row="46" Grid.Column="1"
                                        Value="120" Minimum="20" Maximum="5000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblFrameLoop" Text="{res:Loc prop.detail.frameanim.loop}" Grid.Row="47" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="FrameLoopCheck" Grid.Row="47" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblQrText" Text="{res:Loc prop.detail.qr.text}" Grid.Row="48" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="QrTextBox" Grid.Row="48" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblQrDark" Text="{res:Loc prop.detail.qr.dark}" Grid.Row="49" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="QrDarkColorBox" Grid.Row="49" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblQrLight" Text="{res:Loc prop.detail.qr.light}" Grid.Row="50" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="QrLightColorBox" Grid.Row="50" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblMessageText" Text="{res:Loc prop.detail.message.text}" Grid.Row="51" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="MessageTextBox" Grid.Row="51" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblMessageLevel" Text="{res:Loc prop.detail.message.level}" Grid.Row="52" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="MessageLevelCombo" Grid.Row="52" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.message.level.info}" Tag="info"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.message.level.warn}" Tag="warn"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.message.level.error}" Tag="error"/>
                        </ComboBox>
                        <TextBlock x:Name="LblMessageAutoHide" Text="{res:Loc prop.detail.message.autohide}" Grid.Row="53" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="MessageAutoHideBox" Grid.Row="53" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="600000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblMessageMarquee" Text="{res:Loc prop.detail.message.marquee}" Grid.Row="54" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="MessageMarqueeCheck" Grid.Row="54" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblEnumTextValue" Text="{res:Loc prop.detail.enumtext.value}" Grid.Row="55" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="EnumTextValueBox" Grid.Row="55" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblRollerOptions" Text="{res:Loc prop.detail.roller.options}" Grid.Row="56" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="RollerOptionsBox" Grid.Row="56" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.roller.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblRollerRows" Text="{res:Loc prop.detail.roller.rows}" Grid.Row="57" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="RollerRowsBox" Grid.Row="57" Grid.Column="1"
                                        Value="3" Minimum="3" Maximum="7"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblInputDecimals" Text="{res:Loc prop.param.input.decimals}" Grid.Row="58" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"
                                   ToolTip.Tip="{res:Loc prop.param.input.decimals.hint}"/>
                        <fa:FANumberBox x:Name="InputDecimalsBox" Grid.Row="58" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="6"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <!-- 管道管径（契约 pipe.width）：按点画出来的管道粗细只由它决定 -->
                        <TextBlock x:Name="LblPipeWidth" Text="{res:Loc prop.param.pipe.width}" Grid.Row="59" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"
                                   ToolTip.Tip="{res:Loc prop.param.pipe.width.hint}"/>
                        <fa:FANumberBox x:Name="PipeWidthBox" Grid.Row="59" Grid.Column="1"
                                        Value="12" Minimum="4" Maximum="200"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                    </Grid>
                        </StackPanel>
                        <StackPanel x:Name="DetailParamExpander" Spacing="4" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.behavior.title}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>

                    <!-- 行数 ≥ 下面最大 Grid.Row+1（当前 0..69） -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="70,*" RowSpacing="0" Margin="0,4,0,0">
                        <!-- 同「控件功能参数」：必须显式 0，否则 `Expander Grid` 的全局 4px 让
                             隐藏行也占位（69 行 → 276px 空白）。 -->
                        <TextBlock x:Name="LblGaugeArcWidth" Text="{res:Loc prop.detail.gauge.arcwidth}" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="GaugeArcWidthBox" Grid.Row="0" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="64"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblGaugeTickLen" Text="{res:Loc prop.detail.gauge.ticklen}" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="GaugeTickLenBox" Grid.Row="1" Grid.Column="1"
                                        Value="6" Minimum="0" Maximum="32"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblGaugeNeedleLen" Text="{res:Loc prop.detail.gauge.needlelen}" Grid.Row="2" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="GaugeNeedleLenBox" Grid.Row="2" Grid.Column="1"
                                        Value="0.8" Minimum="0.2" Maximum="1" SmallChange="0.05"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblGaugeNeedleWidth" Text="{res:Loc prop.detail.gauge.needlewidth}" Grid.Row="3" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="GaugeNeedleWidthBox" Grid.Row="3" Grid.Column="1"
                                        Value="4" Minimum="0" Maximum="32"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblGaugeCenterRadius" Text="{res:Loc prop.detail.gauge.centerradius}" Grid.Row="4" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="GaugeCenterRadiusBox" Grid.Row="4" Grid.Column="1"
                                        Value="6" Minimum="0" Maximum="64"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblGaugeShowValue" Text="{res:Loc prop.detail.gauge.showvalue}" Grid.Row="5" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="GaugeShowValueCheck" Grid.Row="5" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblGaugeRanges" Text="{res:Loc prop.detail.gauge.ranges}" Grid.Row="6" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="GaugeRangesBox" Grid.Row="6" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.ranges.hint}"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblLampSize" Text="{res:Loc prop.detail.lamp.size}" Grid.Row="7" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="LampSizeBox" Grid.Row="7" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="400"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblLampRanges" Text="{res:Loc prop.detail.lamp.ranges}" Grid.Row="8" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="LampRangesBox" Grid.Row="8" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.ranges.hint}"
                                 TextChanged="OnPropertyChanged"/>
                        <!-- 批次 1b：进度条 / 加载圈 / 旋钮 / 页签 -->
                        <TextBlock x:Name="LblBarDirection" Text="{res:Loc prop.detail.bar.dir}" Grid.Row="19" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="BarDirectionCombo" Grid.Row="19" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.bar.dir.h}" Tag="Horizontal"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.bar.dir.v}" Tag="Vertical"/>
                        </ComboBox>
                        <TextBlock x:Name="LblBarRanges" Text="{res:Loc prop.detail.bar.ranges}" Grid.Row="20" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="BarRangesBox" Grid.Row="20" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.detail.ranges.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblBarPercent" Text="{res:Loc prop.detail.bar.percent}" Grid.Row="21" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="BarShowPercentCheck" Grid.Row="21" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblSpinnerArcLen" Text="{res:Loc prop.detail.spinner.arclen}" Grid.Row="22" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="SpinnerArcLenBox" Grid.Row="22" Grid.Column="1"
                                        Value="200" Minimum="10" Maximum="360"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblSpinnerArcWidth" Text="{res:Loc prop.detail.spinner.arcwidth}" Grid.Row="23" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="SpinnerArcWidthBox" Grid.Row="23" Grid.Column="1"
                                        Value="4" Minimum="1" Maximum="32"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblKnobArcWidth" Text="{res:Loc prop.detail.knob.arcwidth}" Grid.Row="28" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="KnobArcWidthBox" Grid.Row="28" Grid.Column="1"
                                        Value="10" Minimum="1" Maximum="32"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblTabHeight" Text="{res:Loc prop.detail.tab.height}" Grid.Row="29" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="TabHeightBox" Grid.Row="29" Grid.Column="1"
                                        Value="40" Minimum="16" Maximum="200"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblTabPos" Text="{res:Loc prop.detail.tab.pos}" Grid.Row="30" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="TabPosCombo" Grid.Row="30" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.tab.pos.top}" Tag="Top"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.tab.pos.bottom}" Tag="Bottom"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.tab.pos.left}" Tag="Left"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.tab.pos.right}" Tag="Right"/>
                        </ComboBox>
                        <!-- 批次 2c：报警列表显示细节 -->
                        <TextBlock x:Name="LblAlarmOrder" Text="{res:Loc prop.detail.alarm.order}" Grid.Row="31" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="AlarmOrderCombo" Grid.Row="31" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.order.newest}" Tag="newest_first"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.order.oldest}" Tag="newest_last"/>
                        </ComboBox>
                        <TextBlock x:Name="LblAlarmAckOn" Text="{res:Loc prop.detail.alarm.ack}" Grid.Row="32" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="AlarmAckOnCombo" Grid.Row="32" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.ack.none}" Tag="none"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.ack.click}" Tag="click"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.ack.dblclick}" Tag="dblclick"/>
                        </ComboBox>
                        <TextBlock x:Name="LblAlarmGrid" Text="{res:Loc prop.detail.alarm.grid}" Grid.Row="33" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="AlarmGridCombo" Grid.Row="33" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.grid.all}" Tag="all"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.grid.rows}" Tag="rows"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.grid.border}" Tag="border"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.alarm.grid.none}" Tag="none"/>
                        </ComboBox>
                        <TextBlock x:Name="LblAlarmRowHeight" Text="{res:Loc prop.detail.alarm.rowheight}" Grid.Row="34" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AlarmRowHeightBox" Grid.Row="34" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="60"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblAlarmScrollbar" Text="{res:Loc prop.detail.alarm.scrollbar}" Grid.Row="35" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="AlarmScrollbarCheck" Grid.Row="35" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmRefresh" Text="{res:Loc prop.detail.alarm.refresh}" Grid.Row="36" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AlarmRefreshBox" Grid.Row="36" Grid.Column="1"
                                        Value="500" Minimum="0" Maximum="60000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblAlarmBlink" Text="{res:Loc prop.detail.alarm.blink}" Grid.Row="37" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="AlarmBlinkCheck" Grid.Row="37" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmBlinkMs" Text="{res:Loc prop.detail.alarm.blinkms}" Grid.Row="38" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AlarmBlinkMsBox" Grid.Row="38" Grid.Column="1"
                                        Value="600" Minimum="100" Maximum="5000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblAlarmDateFormat" Text="{res:Loc prop.detail.alarm.datefmt}" Grid.Row="39" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="AlarmDateFormatBox" Grid.Row="39" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmTimeFormat" Text="{res:Loc prop.detail.alarm.timefmt}" Grid.Row="40" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="AlarmTimeFormatBox" Grid.Row="40" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <!-- 批次 2b：实时曲线的采样参数 -->
                        <TextBlock x:Name="LblSampleMs" Text="{res:Loc prop.detail.sample}" Grid.Row="41" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="SampleMsBox" Grid.Row="41" Grid.Column="1"
                                        Value="1000" Minimum="100" Maximum="60000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblHistoryS" Text="{res:Loc prop.detail.history}" Grid.Row="42" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="HistorySBox" Grid.Row="42" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="86400"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <!-- 批次 2d：报警条 -->
                        <TextBlock x:Name="LblAlarmNormalText" Text="{res:Loc prop.detail.alarmbar.normal}" Grid.Row="43" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="AlarmNormalTextBox" Grid.Row="43" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmOnlyUnacked" Text="{res:Loc prop.detail.alarmbar.onlyunacked}" Grid.Row="44" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="AlarmOnlyUnackedCheck" Grid.Row="44" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmScrollMs" Text="{res:Loc prop.detail.alarmbar.scrollms}" Grid.Row="45" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AlarmScrollMsBox" Grid.Row="45" Grid.Column="1"
                                        Value="3000" Minimum="500" Maximum="60000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblAlarmScrollChars" Text="{res:Loc prop.detail.alarmbar.scrollchars}" Grid.Row="46" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AlarmScrollCharsBox" Grid.Row="46" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="64"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblAlarmShowDate" Text="{res:Loc prop.detail.alarmbar.showdate}" Grid.Row="47" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="AlarmShowDateCheck" Grid.Row="47" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAlarmShowTime" Text="{res:Loc prop.detail.alarmbar.showtime}" Grid.Row="48" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="AlarmShowTimeCheck" Grid.Row="48" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <!-- 管道（控件 pipe）：管壁厚度与通道色 -->
                        <TextBlock x:Name="LblPipeWall" Text="{res:Loc prop.detail.pipe.wall}" Grid.Row="49" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="PipeWallBox" Grid.Row="49" Grid.Column="1"
                                        Value="0.2" Minimum="0.05" Maximum="0.45" SmallChange="0.05"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblPipeChannel" Text="{res:Loc prop.detail.pipe.channel}" Grid.Row="50" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="PipeChannelColorBox" Grid.Row="50" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <!-- 通用图元：kind 下拉（契约 figures 的 40 种） -->
                        <TextBlock x:Name="LblShapeKind" Text="{res:Loc prop.detail.shape.kind}" Grid.Row="51" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="ShapeKindCombo" Grid.Row="51" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.arc}" Tag="arc"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.arrow}" Tag="arrow"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.arrow_thick}" Tag="arrow_thick"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.arrow_thin}" Tag="arrow_thin"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.ball3d}" Tag="ball3d"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.callout}" Tag="callout"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.circle}" Tag="circle"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.cone3d}" Tag="cone3d"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.container}" Tag="container"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.cross}" Tag="cross"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.cube}" Tag="cube"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.diamond}" Tag="diamond"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.ellipse}" Tag="ellipse"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.hexagon}" Tag="hexagon"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.line}" Tag="line"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.octagon}" Tag="octagon"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.parallelogram}" Tag="parallelogram"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.pie}" Tag="pie"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.pipe_elbow}" Tag="pipe_elbow"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.pipe_h}" Tag="pipe_h"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.pipe_joint}" Tag="pipe_joint"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.pipe_v}" Tag="pipe_v"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.plane_concave}" Tag="plane_concave"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.plane_convex}" Tag="plane_convex"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.plane_groove}" Tag="plane_groove"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.polygon}" Tag="polygon"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.polyline}" Tag="polyline"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.rect}" Tag="rect"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.right_triangle}" Tag="right_triangle"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.round_rect}" Tag="round_rect"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.star}" Tag="star"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.star5}" Tag="star5"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.tank}" Tag="tank"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.torus3d}" Tag="torus3d"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.trapezoid}" Tag="trapezoid"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.triangle}" Tag="triangle"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.valve_ball}" Tag="valve_ball"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.valve_butterfly}" Tag="valve_butterfly"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.valve_gate}" Tag="valve_gate"/>
                            <ComboBoxItem Content="{res:Loc prop.shape.kind.wedge}" Tag="wedge"/>
                        </ComboBox>
                        <TextBlock x:Name="LblChartKind" Text="{res:Loc prop.detail.chart.kind}" Grid.Row="52" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="ChartKindCombo" Grid.Row="52" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.chart.kind.bar}" Tag="bar"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.chart.kind.pie}" Tag="pie"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.chart.kind.donut}" Tag="donut"/>
                        </ComboBox>
                        <TextBlock x:Name="LblChartSeries" Text="{res:Loc prop.detail.chart.series}" Grid.Row="53" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="ChartSeriesBox" Grid.Row="53" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblChartLegend" Text="{res:Loc prop.detail.chart.legend}" Grid.Row="54" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="ChartLegendCheck" Grid.Row="54" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblChartValue" Text="{res:Loc prop.detail.chart.value}" Grid.Row="55" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="ChartValueCheck" Grid.Row="55" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblXyTagX" Text="{res:Loc prop.detail.xy.tagx}" Grid.Row="56" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="XyTagXBox" Grid.Row="56" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblXyTagY" Text="{res:Loc prop.detail.xy.tagy}" Grid.Row="57" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="XyTagYBox" Grid.Row="57" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblXyDot" Text="{res:Loc prop.detail.xy.dot}" Grid.Row="58" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="XyDotCheck" Grid.Row="58" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblXyLine" Text="{res:Loc prop.detail.xy.line}" Grid.Row="59" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="XyLineCheck" Grid.Row="59" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblHistColumns" Text="{res:Loc prop.detail.histtable.columns}" Grid.Row="60" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="HistColumnsBox" Grid.Row="60" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblHistGroup" Text="{res:Loc prop.detail.histtable.group}" Grid.Row="61" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="HistGroupBox" Grid.Row="61" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblHistRowHeight" Text="{res:Loc prop.detail.histtable.rowheight}" Grid.Row="62" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="HistRowHeightBox" Grid.Row="62" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="60"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblHistScrollbar" Text="{res:Loc prop.detail.histtable.scrollbar}" Grid.Row="63" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="HistScrollbarCheck" Grid.Row="63" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <!-- 最大行数：契约 history_table.max_rows（缺省 500，范围 10..2000）。
                             取的是模型里独立的 HistTableMaxRows —— 复用过报警列表的 10
                             会让历史表恒只显示 10 行。 -->
                        <TextBlock x:Name="LblHistMaxRows" Text="{res:Loc prop.detail.histtable.maxrows}" Grid.Row="69" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="HistMaxRowsBox" Grid.Row="69" Grid.Column="1"
                                        Value="500" Minimum="10" Maximum="2000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblRecipeColumns" Text="{res:Loc prop.detail.recipe.columns}" Grid.Row="64" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="RecipeColumnsBox" Grid.Row="64" Grid.Column="1" FontSize="13" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblRecipeGroup" Text="{res:Loc prop.detail.recipe.group}" Grid.Row="65" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="RecipeGroupBox" Grid.Row="65" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblRecipeUnit" Text="{res:Loc prop.detail.recipe.unit}" Grid.Row="66" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="RecipeUnitCheck" Grid.Row="66" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblAsciiEncoding" Text="{res:Loc prop.detail.ascii.encoding}" Grid.Row="67" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="AsciiEncodingCombo" Grid.Row="67" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.detail.ascii.encoding.gbk}" Tag="gbk"/>
                            <ComboBoxItem Content="{res:Loc prop.detail.ascii.encoding.utf8}" Tag="utf8"/>
                        </ComboBox>
                        <TextBlock x:Name="LblAsciiMaxLen" Text="{res:Loc prop.detail.ascii.maxlen}" Grid.Row="68" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="AsciiMaxLenBox" Grid.Row="68" Grid.Column="1"
                                        Value="32" Minimum="1" Maximum="64"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                    </Grid>
                        </StackPanel>
                        <!-- 专属参数：运行时确实读了、但此前没有可编辑行的属性。
                             每行是一个具名 Grid 行容器（切显隐切整行，避免隐藏后留空行）；
                             图元 kind 级参数由 FigureParamHost 按 FigurePropertyCatalog 动态生成。 -->
                        <StackPanel x:Name="ExclusiveParamExpander" Spacing="4" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.exclusive.title}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <Grid x:Name="RowArcStart" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc arc.start.angle}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ArcStartBox" Grid.Column="1" Minimum="-360" Maximum="720" Value="0"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowArcEnd" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc arc.end.angle}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ArcEndBox" Grid.Column="1" Minimum="-360" Maximum="720" Value="360"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowGaugeLabelPos" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.gauge.labelpos}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GaugeLabelPosCombo" Grid.Column="1" SelectedIndex="0"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                          SelectionChanged="OnPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc prop.exclusive.gauge.labelpos.inside}" Tag="inside"/>
                                    <ComboBoxItem Content="{res:Loc prop.exclusive.gauge.labelpos.outside}" Tag="outside"/>
                                    <ComboBoxItem Content="{res:Loc prop.exclusive.gauge.labelpos.none}" Tag="none"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="KnobShowValueCheck" IsVisible="False" Content="{res:Loc prop.exclusive.knob.showvalue}"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12" IsCheckedChanged="OnPropertyChanged"/>
                            <Grid x:Name="RowChartDecimals" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.chart.decimals}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ChartDecimalsBox" Grid.Column="1" Minimum="0" Maximum="6" Value="0"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowHistRefresh" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.hist.refresh}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="HistRefreshBox" Grid.Column="1" Minimum="0" Maximum="600000" Value="5000"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowCurveRefresh" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.curve.refresh}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="CurveRefreshBox" Grid.Column="1" Minimum="0" Maximum="600000" Value="5000"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowRecipeRowHeight" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.recipe.rowheight}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="RecipeRowHeightBox" Grid.Column="1" Minimum="0" Maximum="60" Value="0"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <CheckBox x:Name="RecipeScrollbarCheck" IsVisible="False" Content="{res:Loc prop.exclusive.recipe.scrollbar}"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12" IsCheckedChanged="OnPropertyChanged"/>
                            <Grid x:Name="RowAlarmFilter" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.alarm.filter}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="AlarmLevelFilterBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}"
                                         PlaceholderText="{res:Loc prop.exclusive.alarm.filter.hint}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowAlarmColumns" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.alarm.columns}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="AlarmColumnsBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}"
                                         PlaceholderText="{res:Loc prop.exclusive.alarm.columns.hint}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowAlarmScroll" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.alarm.scroll}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="AlarmScrollCombo" Grid.Column="1" SelectedIndex="0"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                          SelectionChanged="OnPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc prop.exclusive.alarm.scroll.auto}" Tag="auto"/>
                                    <ComboBoxItem Content="{res:Loc prop.exclusive.alarm.scroll.none}" Tag="none"/>
                                </ComboBox>
                            </Grid>
                            <Grid x:Name="RowPipeWallColor" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.pipe.wallcolor}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="PipeWallColorBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}"
                                         PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowBoxColor" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.checkbox.boxcolor}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxColorBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}"
                                         PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowKeyboardTarget" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.keyboard.target}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="KeyboardTargetBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}"
                                         PlaceholderText="{res:Loc prop.exclusive.keyboard.target.hint}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowXyXMin" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.xy.xmin}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="XyXMinBox" Grid.Column="1" Minimum="-1000000" Maximum="1000000" Value="0"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowXyXMax" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.xy.xmax}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="XyXMaxBox" Grid.Column="1" Minimum="-1000000" Maximum="1000000" Value="100"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowXyXDecimals" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.xy.xdecimals}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="XyXDecimalsBox" Grid.Column="1" Minimum="0" Maximum="6" Value="0"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowFigureFillOpa" ColumnDefinitions="70,*" IsVisible="False">
                                <TextBlock Text="{res:Loc prop.exclusive.figure.fillopa}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="FigureFillOpaBox" Grid.Column="1" Minimum="0" Maximum="255" Value="255"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowFigurePoints" IsVisible="False">
                                <Grid ColumnDefinitions="70,*">
                                    <TextBlock Text="{res:Loc prop.exclusive.figure.points}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FigurePointsHint" Grid.Column="1" Text="{res:Loc prop.exclusive.figure.points.hint}"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBox x:Name="FigurePointsBox" FontSize="13" Margin="0,2,0,0" MinHeight="56" MaxHeight="120"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <StackPanel x:Name="FigureParamHost" Spacing="4"/>
                        </StackPanel>
                        <StackPanel x:Name="CurveParamExpander" Spacing="4" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.trend.title}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="70,*" RowSpacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="LblCurveAxis" Text="{res:Loc prop.curve.axis}" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveAxisColorBox" Grid.Row="0" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveBg" Text="{res:Loc prop.curve.bg}" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveBgColorBox" Grid.Row="1" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveBorder" Text="{res:Loc prop.curve.border}" Grid.Row="2" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveBorderColorBox" Grid.Row="2" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveGrid" Text="{res:Loc prop.curve.grid}" Grid.Row="3" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveGridColorBox" Grid.Row="3" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveTick" Text="{res:Loc prop.curve.tick}" Grid.Row="4" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveTickColorBox" Grid.Row="4" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveLabel" Text="{res:Loc prop.curve.label}" Grid.Row="5" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <TextBox x:Name="CurveLabelColorBox" Grid.Row="5" Grid.Column="1" FontSize="13" Margin="0,2"
                                 Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" IsVisible="False"
                                 PlaceholderText="{res:Loc prop.color.hint}" TextChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveShowGrid" Text="{res:Loc prop.curve.showgrid}" Grid.Row="6" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="CurveGridCheck" Grid.Row="6" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveLegend" Text="{res:Loc prop.curve.legend}" Grid.Row="7" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="CurveLegendCheck" Grid.Row="7" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveShowAxis" Text="{res:Loc prop.curve.showaxis}" Grid.Row="8" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="CurveShowAxisCheck" Grid.Row="8" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveShowLabels" Text="{res:Loc prop.curve.showlabels}" Grid.Row="9" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <CheckBox x:Name="CurveShowLabelsCheck" Grid.Row="9" Grid.Column="1"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,2" IsVisible="False"
                                  IsCheckedChanged="OnPropertyChanged"/>
                        <TextBlock x:Name="LblCurveDirection" Text="{res:Loc prop.curve.direction}" Grid.Row="10" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="CurveDirectionCombo" Grid.Row="10" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.curve.dir.lr}" Tag="lr"/>
                            <ComboBoxItem Content="{res:Loc prop.curve.dir.rl}" Tag="rl"/>
                        </ComboBox>
                        <TextBlock x:Name="LblCurveXFormat" Text="{res:Loc prop.curve.xformat}" Grid.Row="11" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <ComboBox x:Name="CurveXFormatCombo" Grid.Row="11" Grid.Column="1"
                                  Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                  SelectedIndex="0" IsVisible="False" SelectionChanged="OnPropertyChanged">
                            <ComboBoxItem Content="{res:Loc prop.curve.xformat.clock}" Tag="clock"/>
                            <ComboBoxItem Content="{res:Loc prop.curve.xformat.rel}" Tag="rel"/>
                        </ComboBox>
                        <TextBlock x:Name="LblCurveXDiv" Text="{res:Loc prop.curve.xdiv}" Grid.Row="12" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveXDivBox" Grid.Row="12" Grid.Column="1"
                                        Value="4" Minimum="1" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveXMinor" Text="{res:Loc prop.curve.xminor}" Grid.Row="13" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveXMinorBox" Grid.Row="13" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveXLabelStep" Text="{res:Loc prop.curve.xstep}" Grid.Row="14" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveXLabelStepBox" Grid.Row="14" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveYDiv" Text="{res:Loc prop.curve.ydiv}" Grid.Row="15" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveYDivBox" Grid.Row="15" Grid.Column="1"
                                        Value="4" Minimum="1" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveYMinor" Text="{res:Loc prop.curve.yminor}" Grid.Row="16" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveYMinorBox" Grid.Row="16" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveYDecimals" Text="{res:Loc prop.curve.ydecimals}" Grid.Row="17" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveYDecimalsBox" Grid.Row="17" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="6"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveYDigits" Text="{res:Loc prop.curve.ydigits}" Grid.Row="18" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveYDigitsBox" Grid.Row="18" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveY2Min" Text="{res:Loc prop.curve.y2min}" Grid.Row="19" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveY2MinBox" Grid.Row="19" Grid.Column="1"
                                        Value="0" Minimum="-1000000" Maximum="1000000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveY2Max" Text="{res:Loc prop.curve.y2max}" Grid.Row="20" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveY2MaxBox" Grid.Row="20" Grid.Column="1"
                                        Value="100" Minimum="-1000000" Maximum="1000000"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveY2Decimals" Text="{res:Loc prop.curve.y2decimals}" Grid.Row="21" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveY2DecimalsBox" Grid.Row="21" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="6"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveY2Digits" Text="{res:Loc prop.curve.y2digits}" Grid.Row="22" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveY2DigitsBox" Grid.Row="22" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="12"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                        <TextBlock x:Name="LblCurveLastMin" Text="{res:Loc prop.curve.lastmin}" Grid.Row="23" Grid.Column="0"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center" IsVisible="False"/>
                        <fa:FANumberBox x:Name="CurveLastMinBox" Grid.Row="23" Grid.Column="1"
                                        Value="0" Minimum="0" Maximum="1440"
                                        SpinButtonPlacementMode="Compact" Margin="0,2" IsVisible="False"/>
                    </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- ═══ 动作与高级 ═══ -->
                <Expander x:Name="ActionsAdvancedSection" Header="{res:Loc prop.section.actions.advanced}" IsExpanded="False"
                          Background="{StaticResource HmiBgCardBrush}" CornerRadius="6" Padding="8,4"
                          IsVisible="False">
                    <StackPanel Margin="0,4,0,0" Spacing="6">
                        <!-- 长按提示是**交互**属性（按下并保持才出现），跟几何无关；
                             从「位置与大小」挪到高级区，与动作/Faceplate 同处。 -->
                        <Grid x:Name="RowTooltip" ColumnDefinitions="62,*">
                            <TextBlock Text="{res:Loc prop.tooltip}" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TooltipBox" Grid.Column="1"
                                     TextChanged="OnPropertyChanged" MaxLength="64"/>
                        </Grid>
                        <!-- 交互行为：二次确认 / 按下保持 / 长按触发 / 禁用表现 / 输入框提交时机。
                             这几行裁决"点下去会发生什么"，与数据参数无关，因此跟长按提示、动作同处一区。 -->
                        <StackPanel x:Name="InteractionExpander" Spacing="4" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.section.interaction}"
                                       Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <Grid x:Name="RowBtnConfirm" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnConfirm" Text="{res:Loc prop.detail.button.confirm}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ConfirmTextBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowBtnConfirmYes" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnConfirmYes" Text="{res:Loc prop.detail.button.yes}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ConfirmYesBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowBtnConfirmNo" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnConfirmNo" Text="{res:Loc prop.detail.button.no}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ConfirmNoBox" Grid.Column="1" FontSize="13" Margin="0,2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" TextChanged="OnPropertyChanged"/>
                            </Grid>
                            <Grid x:Name="RowBtnConfirmWait" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnConfirmWait" Text="{res:Loc prop.detail.button.wait}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="ConfirmWaitMsBox" Grid.Column="1"
                                                Value="0" Minimum="0" Maximum="600000"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowBtnHold" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnHold" Text="{res:Loc prop.detail.button.hold}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="HoldMsBox" Grid.Column="1"
                                                Value="0" Minimum="0" Maximum="5000"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowBtnLongPress" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnLongPress" Text="{res:Loc prop.detail.button.longpress}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <fa:FANumberBox x:Name="LongPressMsBox" Grid.Column="1"
                                                Value="800" Minimum="300" Maximum="5000"
                                                SpinButtonPlacementMode="Compact" Margin="0,2"/>
                            </Grid>
                            <Grid x:Name="RowBtnOffStyle" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblBtnOffStyle" Text="{res:Loc prop.detail.button.offstyle}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OffStyleCombo" Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                          SelectedIndex="0" SelectionChanged="OnPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc prop.detail.button.offstyle.dim}" Tag="dim"/>
                                    <ComboBoxItem Content="{res:Loc prop.detail.button.offstyle.hide}" Tag="hide"/>
                                </ComboBox>
                            </Grid>
                            <Grid x:Name="RowInputCommit" ColumnDefinitions="62,*" IsVisible="False">
                                <TextBlock x:Name="LblInputCommit" Text="{res:Loc prop.detail.input.commit}" Grid.Column="0"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="InputCommitCombo" Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                          SelectedIndex="0" SelectionChanged="OnPropertyChanged">
                                    <ComboBoxItem Content="{res:Loc prop.detail.input.commit.ok}" Tag="ok"/>
                                    <ComboBoxItem Content="{res:Loc prop.detail.input.commit.blur}" Tag="blur"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="FaceplateParamExpander" Spacing="6" IsVisible="False">
                    <StackPanel x:Name="FaceplateParamPanel" Spacing="6" Margin="0,4,0,0">
                        <TextBlock x:Name="FaceplateTemplateName" Text=""
                                   Foreground="{StaticResource HmiLinkBrush}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock x:Name="FaceplateTemplateDesc" Text=""
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <!-- 动态参数区：参数编辑器只往这里加。刷新走 Host.Children.Clear()，
                             不依赖「前两个子元素是固定表头」这类位置假设。 -->
                        <StackPanel x:Name="FaceplateParamHost" Spacing="6"/>
                    </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ActionExpander" Spacing="6">

                        <!-- 动作列表（多动作管理）-->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ItemsControl x:Name="ActionList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="views:ActionChipModel">
                                        <Button Content="{Binding DisplayName}"
                                                Tag="{Binding}"
                                                Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                                BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3" FontSize="12"
                                                Click="OnActionChipClicked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{res:Loc prop.add.action}" Tag="__add__"
                                    Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiLinkBrush}"
                                    BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" FontSize="12"
                                    Click="OnActionChipClicked"/>
                        </StackPanel>

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="70,*" RowSpacing="4">
                            <TextBlock Text="{res:Loc prop.action.type}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CboActionType" Grid.Row="0" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                      SelectedIndex="0"
                                      SelectionChanged="OnActionTypeChanged"/>

                            <TextBlock Text="{res:Loc prop.action.target}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CboActionTarget" Grid.Row="1" Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                                      IsEditable="True"
                                      PlaceholderText="{res:Loc prop.action.target.hint}"
                                      SelectionChanged="OnActionTargetSelected"/>

                            <TextBlock x:Name="LblActionValue" Text="{res:Loc prop.action.value}" Grid.Row="2" Grid.Column="0"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtActionValue" Grid.Row="2" Grid.Column="1"
                                     Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                     BorderBrush="{StaticResource HmiInputBorderBrush}" Padding="8,4" FontSize="13"
                                     PlaceholderText="{res:Loc prop.action.value.hint}"
                                     TextChanged="OnPropertyChanged"/>
                        </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AiSuggestExpander" IsVisible="False">
                            <TextBlock Text="{res:Loc prop.ai.suggest}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <StackPanel x:Name="AiSuggestPanel" Margin="0,4,0,0" Spacing="6">
                        <TextBlock x:Name="AiScoreText" Text=""
                                   Foreground="{StaticResource HmiWarningBrush}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <ItemsControl x:Name="AiIssueList">
                            <ItemsControl.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource HmiTextPrimarySoftBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource HmiLinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,3"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </ItemsControl.Styles>
                        </ItemsControl>
                        <Button x:Name="BtnAutoFix" Content="{res:Loc prop.one.click.fix}"
                                Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="10,4" FontSize="11"
                                HorizontalAlignment="Left"
                                Click="OnAutoFixClicked"/>
                    </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
