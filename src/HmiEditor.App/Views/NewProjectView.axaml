<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.NewProjectView"
        Title="{res:Loc project.new}"
        Width="820"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Noto Sans CJK SC">
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标题栏：拖拽 + 关闭由 ChromeWindow 基类处理 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc project.new}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <TextBlock Text="✕" FontSize="12" FontFamily="Segoe UI Symbol, Noto Sans CJK SC"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="200,*">
                <!-- 品牌栏：与引导页同一套底色，避免"新窗口像是别的软件" -->
                <Border Grid.Column="0"
                        CornerRadius="0,0,0,10"
                        Background="{StaticResource HmiBgPanelBrush}"
                        BorderBrush="{StaticResource HmiBorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="18">
                    <StackPanel VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="{res:Loc new.project.brand}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="{res:Loc splash.subtitle}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{StaticResource HmiBorderBrush}" Margin="0,6"/>
                        <TextBlock Text="{res:Loc new.project.intro}"
                                   Foreground="{StaticResource HmiTextPrimarySoftBrush}"
                                   FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- 表单 + 参数摘要 -->
                <Grid Grid.Column="1" Margin="18,14,18,14"
                      RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="96,*" Margin="0,0,0,10">
                        <TextBlock Text="{res:Loc project.settings.basic.name}"
                                   Foreground="{StaticResource HmiTextPrimarySoftBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtProjectName" Grid.Column="1"
                                 PlaceholderText="{res:Loc new.project.name.hint}"
                                 Background="{StaticResource HmiBgInputBrush}"
                                 Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                 CornerRadius="4" Padding="8,6"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="96,*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{res:Loc new.project.location}"
                                   Foreground="{StaticResource HmiTextPrimarySoftBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtLocation" Grid.Column="1"
                                 Background="{StaticResource HmiBgInputBrush}"
                                 Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                 CornerRadius="4" Padding="8,6"/>
                        <Button x:Name="BtnBrowse" Grid.Column="2"
                                Content="{res:Loc settings.autoexport.browse}"
                                Margin="8,0,0,0" Padding="12,6" CornerRadius="4"
                                Background="{StaticResource HmiBgInputBrush}"
                                Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="96,*" Margin="0,0,0,12">
                        <TextBlock Text="{res:Loc project.settings.basic.hw.target}"
                                   Foreground="{StaticResource HmiTextPrimarySoftBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbTarget" Grid.Column="1"
                                  Background="{StaticResource HmiBgInputBrush}"
                                  Foreground="{StaticResource HmiTextPrimaryBrush}"
                                  BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                  CornerRadius="4" Padding="8,4"/>
                    </Grid>

                    <!-- 型号参数：选中型号即刷新，用户在落盘之前就能看到分辨率/内存预算 -->
                    <Border Grid.Row="3"
                            Background="{StaticResource HmiBgPanelBrush}"
                            BorderBrush="{StaticResource HmiBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Loc new.project.summary}"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="120,*,120,*"
                                  RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{res:Loc new.project.summary.vendor}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumVendor" Grid.Row="0" Grid.Column="1"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{res:Loc new.project.summary.arch}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumArch" Grid.Row="0" Grid.Column="3"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{res:Loc new.project.summary.resolution}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumResolution" Grid.Row="1" Grid.Column="1"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{res:Loc new.project.summary.depth}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumDepth" Grid.Row="1" Grid.Column="3"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{res:Loc new.project.summary.ram}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumRam" Grid.Row="2" Grid.Column="1"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{res:Loc new.project.summary.flash}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtSumFlash" Grid.Row="2" Grid.Column="3"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 校验失败就地显示：不弹二级框，用户改哪一项就看哪一行 -->
                    <TextBlock x:Name="TxtError" Grid.Row="4"
                               Foreground="{StaticResource HmiDangerBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Top" Margin="0,8,0,0"
                               IsVisible="False"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="BtnCreate"
                                Content="{res:Loc new.project.create}"
                                Background="{StaticResource HmiAccentHoverBrush}"
                                Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="22,7" CornerRadius="4"/>
                        <Button x:Name="BtnCancel"
                                Content="{res:Loc gen.cancel}"
                                Background="{StaticResource HmiBgElevatedBrush}"
                                Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="22,7" CornerRadius="4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</cw:ChromeWindow>
