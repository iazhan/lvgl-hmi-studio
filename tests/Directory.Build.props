<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 所有测试程序集统一重定向应用数据根（HMI_APP_DATA_ROOT → 仓库内 .hmi-test-tmp/appdata），
         避免被测产品代码（AppPaths）往开发者真实的配置目录写中间产物。
         见 tests/_shared/TestAppDataRootSetup.cs 的说明。

         排除 TestSupport：它是被测项目引用的**辅助库**，不是测试程序集，
         没必要也带上模块初始化器（且会触发 CA2255 —— 该分析器只在测试/应用项目里放行）。 -->
    <Compile Include="$(MSBuildThisFileDirectory)_shared/TestAppDataRootSetup.cs"
             Link="TestAppDataRootSetup.cs"
             Condition="'$(MSBuildProjectName)' != 'HmiEditor.TestSupport'" />
  </ItemGroup>

  <ItemGroup Label="原生 lua 校验库（跑 LuaSyntaxValidator 的用例需要它；见 tools/build-lua.sh）">
    <None Include="$(MSBuildThisFileDirectory)../third_party/lua-5.4.7/lib/linux-x64/liblua54.so"
          Link="liblua54.so" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(OS)' != 'Windows_NT'" />
    <None Include="$(MSBuildThisFileDirectory)../third_party/lua-5.4.7/lib/win-x64/lua54.dll"
          Link="lua54.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>
</Project>
